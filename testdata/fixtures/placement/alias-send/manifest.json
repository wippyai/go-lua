{
  "description": "Sending any alias of an allocation upgrades that allocation site.",
  "packages": ["process"],
  "check": {
    "placement": {
      "require_complete": true,
      "min_shared_heap": 1,
      "max_shared_heap": 1,
      "max_stack": 0,
      "min_shared_heap_kind": {
        "lua.table": 1
      },
      "max_shared_heap_kind": {
        "lua.table": 1
      },
      "max_unknown": 0
    }
  }
}
