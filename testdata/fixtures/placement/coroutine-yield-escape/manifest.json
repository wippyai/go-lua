{
  "description": "A table yielded out of a coroutine crosses an unmodeled boundary and must not remain stack-local.",
  "packages": ["process"],
  "check": {
    "placement": {
      "require_complete": true,
      "min_shared_heap": 2,
      "max_stack": 0,
      "max_owned_heap": 0,
      "min_shared_depth": 2,
      "min_shared_heap_kind": {
        "lua.table": 2
      },
      "max_stack_kind": {
        "lua.table": 0
      },
      "max_unknown": 0
    }
  }
}
