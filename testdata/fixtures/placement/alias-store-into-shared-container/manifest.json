{
  "description": "Storing an alias into an already shared container upgrades the alias allocation site.",
  "packages": ["process"],
  "check": {
    "placement": {
      "require_complete": true,
      "min_shared_heap": 2,
      "max_shared_heap": 2,
      "max_stack": 0,
      "min_shared_heap_kind": {
        "lua.table": 2
      },
      "max_shared_heap_kind": {
        "lua.table": 2
      },
      "max_unknown": 0
    }
  }
}
