{
  "description": "A declared host global publishes a full binding row (identity, type, use order, value carrier); analysis type ingress alone is not runtime value authority.",
  "packages": [
    "stream"
  ],
  "check": {
    "errors": 0,
    "native": {
      "facts": [
        {
          "name": "at least 1 proven host_global_binding row(s)",
          "lane": "values",
          "family": "host_global_binding",
          "trust": "proven",
          "min": 1
        },
        {
          "name": "at most 0 host_global_binding.unknown row(s)",
          "family": "host_global_binding",
          "value_contains": [
            "unknown"
          ],
          "max": 0
        },
        {
          "name": "host_global_binding row",
          "lane": "values",
          "family": "host_global_binding",
          "value_contains": [
            "identity=published",
            "type=published",
            "used_order=published",
            "value_carrier=published"
          ],
          "trust": "proven",
          "min": 1,
          "revoked_by": [
            {
              "event": "write.global"
            },
            {
              "event": "load.dynamic"
            }
          ],
          "revoked_by_exhaustive": true
        },
        {
          "name": "host_global_binding must not carry type_ingress_only",
          "lane": "values",
          "family": "host_global_binding",
          "value_contains": [
            "type_ingress_only"
          ],
          "max": 0
        },
        {
          "name": "host_global_binding must not carry assumed_binding",
          "lane": "values",
          "family": "host_global_binding",
          "value_contains": [
            "assumed_binding"
          ],
          "max": 0
        }
      ]
    }
  },
  "run": {
    "skip": "checker-only native fact fixture"
  }
}
